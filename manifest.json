{
  "manifest_version": 3,
  "name": "Polyglot for Chrome",
  "description": "Translate selected text into your native language.",
  "version": "1.0.1",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": ["https://translate.googleapis.com/*", "https://clients5.google.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Translate selected text", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_page": "options.html",
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Translate selected text"
    }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
